# Copy to `.env` and adjust. Do not commit `.env`.
#
# --- BigQuery (split table ids; resolves to project.dataset.table) ---
PROJECT_ID=lkq-uki-ga-warehouse-prod
DATASET_ID=google_trends
TRENDS_DAILY_TABLE_ID=03_trends_daily
STITCH_QUALITY_TABLE_ID=02_stitch_quality
REFERENCE_WEEKLY_TABLE_ID=01_reference_weekly

# --- Full-run dates (used when TRENDS_RUN_MODE=full). Daily mode uses lookback below. ---
START_DATE=2024-09-01
END_DATE=2026-04-23

# --- Terms: if TRENDS_TERMS is set (non-empty), it wins and QUERY_TERM is ignored. ---
# Use QUERY_TERM for a single term, or TRENDS_TERMS for many (comma-separated or JSON array).
QUERY_TERM="engine oil"
# TRENDS_TERMS=

TRENDS_GEO=GB
TRENDS_HL=en-GB

# --- Weekly reference window for Playwright (should cover stitched daily span) ---
TRENDS_WEEKLY_START=2024-09-01
TRENDS_WEEKLY_END=2026-04-23

# --- Run mode: full uses START_DATE/END_DATE; daily uses lookback + optional TRENDS_AS_OF_DATE ---
TRENDS_RUN_MODE=full
TRENDS_DAILY_LOOKBACK_DAYS=365

TRENDS_MAX_TERMS_PER_QUERY=5

# --- Cloud Functions / artifact upload ---
FUNCTION_TARGET=run_trends_job
GCS_OUTPUT_BUCKET=scraper-goog-le-trends
